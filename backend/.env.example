# Copia este archivo a .env y rellena los valores reales
# .env está en .gitignore — nunca lo subas al repo

# Credenciales Facturama sandbox (apisandbox.facturama.mx)
FACTURAMA_USER=tu_usuario_aqui
FACTURAMA_PASS=tu_password_aqui

# Email de remitente (para SES — debe estar verificado en AWS SES)
SES_FROM_EMAIL=tu@email.com

# ── Solo para --mode aws (post sam deploy) ────────────────────────
# Estos valores los imprime SAM al final del deploy
# DYNAMODB_TABLE=factufast-facturas-dev
# COUNTERS_TABLE=factufast-counters-dev
# S3_BUCKET=<nombre generado por SAM>
# SES_CONFIG_SET=factufast-config
